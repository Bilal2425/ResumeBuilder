# GitHub username (lowercase, used for GHCR container registry images)
GITHUB_USERNAME=your_github_username

# Secret code required for registering new accounts
REGISTRATION_INVITE_CODE=your_secret_registration_invite_code_here

# PostgreSQL Database Password
POSTGRES_PASSWORD=your_secure_postgres_password_here

# JWT Secret Key (Minimum 32 characters long)
JWT_SECRET=your_super_secret_jwt_key_must_be_at_least_32_characters_long
